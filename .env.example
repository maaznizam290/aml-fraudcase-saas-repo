# GEMINI_API_KEY: Optional fallback key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Required for Claude 3.5/3.7 Sonnet AI investigation recommendations.
# When DEMO_MODE=true and key is unset, falls back to structured rule-based heuristic evaluator.
ANTHROPIC_API_KEY=""

# SUPABASE_URL: Supabase PostgreSQL Project URL.
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Supabase PostgreSQL Service Role Key (for secure server-side operations).
SUPABASE_SERVICE_ROLE_KEY=""

# N8N_WEBHOOK_URL: Webhook URL for external n8n orchestration intake pipeline.
N8N_WEBHOOK_URL=""

# SLACK_BOT_TOKEN: Slack Bot OAuth Token for sending real-time #compliance-alerts-p1 Block Kit cards.
SLACK_BOT_TOKEN=""

# DEMO_MODE: Set to "true" to enable local in-memory storage & synthetic fallback with full functional pipeline.
# If DEMO_MODE="false", the server will fail loudly on startup if ANTHROPIC_API_KEY, SUPABASE_URL, or SUPABASE_SERVICE_ROLE_KEY are missing.
DEMO_MODE="true"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

